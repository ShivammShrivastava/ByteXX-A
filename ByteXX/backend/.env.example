# ─────────────────────────────────────────────────────────────────────────────
# SatQuery AI — Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# Run with: uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload
# ─────────────────────────────────────────────────────────────────────────────

# ── HuggingFace Cache (local desktop folder) ──────────────────────────────────
# Points transformers to the already-downloaded Qwen2.5-VL-3B model
HF_HOME=C:\Users\Suryansh\OneDrive\Desktop\huggingface

# ── Model ─────────────────────────────────────────────────────────────────────

# Set to "real" to load Qwen2.5-VL-3B + LoRA (requires GPU + VRAM)
# Set to "stub" to skip loading (useful for testing the Firebase pipeline only)
SATQUERY_MODEL_MODE=real

# Base model name from HuggingFace Hub (will be loaded from HF_HOME cache)
SATQUERY_BASE_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Path to local LoRA adapter directory
SATQUERY_ADAPTER_PATH=C:\Users\Suryansh\OneDrive\Desktop\satquery-ai-vqa-lora

# HuggingFace repo for LoRA adapter (fallback if local path not found)
SATQUERY_HF_LORA_REPO=shivamw/satquery-ai-vqa-lora

# Enable 4-bit NF4 quantization — requires bitsandbytes + CUDA GPU
SATQUERY_LOAD_IN_4BIT=true

# ── Generation ────────────────────────────────────────────────────────────────
SATQUERY_MAX_TOKENS_VQA=64
SATQUERY_MAX_TOKENS_CAPTION=256
SATQUERY_MAX_TOKENS_REFER=512
SATQUERY_TEMPERATURE=0.1
SATQUERY_DO_SAMPLE=false

# ── Server ────────────────────────────────────────────────────────────────────
SATQUERY_HOST=0.0.0.0
SATQUERY_PORT=8000

# Comma-separated list of allowed CORS origins, or * for all
SATQUERY_CORS_ORIGINS=*

# Max image upload size in MB
SATQUERY_MAX_IMAGE_MB=10

# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: serviceAccountKey.json
# ─────────────────────────────────────────────────────────────────────────────
# The Firebase Admin SDK requires a service account key file to:
#   - Listen to Firebase Realtime DB
#   - Download images from Firebase Storage
#
# How to get it:
#   1. Go to Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key"
#   3. Save the downloaded JSON as: backend/serviceAccountKey.json
#
# ⚠ DO NOT commit this file to git — it's already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────
